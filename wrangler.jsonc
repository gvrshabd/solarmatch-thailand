{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solarmatch-thailand",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://millys.cloudflareaccess.com",
    "ACCESS_AUD": "b717abfa537a10f8817266c0b9fdab777a99154fbdc53679e88e067151e7bccd",
    "PRIVATE_SITE_ACCESS_AUD": "633047706f0772daa15ccba333afda4b2da9352e26a61c20259c9698ebb6af6e",
    "PRIVATE_CONTACT_PREVIEW_ENABLED": "true"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solarmatch-thailand-admin",
      "database_id": "61d0704e-5c1f-4bf6-bf58-32dbe07e9f65",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "solarmatch-thailand-storage"
    }
  ]
}
