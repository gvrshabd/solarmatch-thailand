{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "account_id": "e364d5c7864e07143bd229b367b95637",
  "name": "solarmatch-installer-staging",
  "main": "../dist/server/index.js",
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "../dist/client", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": false },
  "triggers": { "crons": [] },
  "vars": {
    "INSTALLER_PLATFORM_MODE": "sandbox",
    "INSTALLER_BASE_URL": "https://solarmatch-installer-staging.deluxejahseh.workers.dev",
    "STAGING_ACCESS_AUD": "",
    "ACCESS_TEAM_DOMAIN": "https://millys.cloudflareaccess.com",
    "ACCESS_AUD": "",
    "INSTALLER_TEST_CLOCK_ENABLED": "false",
    "INSTALLER_SCHEDULER_EXPECTED": "false",
    "OUTBOUND_MESSAGES_ENABLED": "false",
    "CAMPAIGN_ATTRIBUTION_ENABLED": "false",
    "CAMPAIGN_ATTRIBUTION_PRIVACY_REVIEWED": "false",
    "AUTH_EMAIL_PROVIDER_MODE": "off",
    "AUTH_EMAIL_LIVE_ENABLED": "false",
    "SMS_PROVIDER_MODE": "off",
    "SMS_LIVE_ENABLED": "false",
    "OMISE_PROVIDER_MODE": "off",
    "OMISE_LIVE_ENABLED": "false",
    "LINE_PROVIDER_MODE": "sandbox",
    "LINE_LIVE_ENABLED": "false",
    "STAGING_LINE_MAX_MESSAGES": "3"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "solarmatch-installer-staging-db", "database_id": "153b8867-e7ad-40ad-8a63-c2bde2338b43", "migrations_dir": "../migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "solarmatch-installer-staging-private" }]
}
