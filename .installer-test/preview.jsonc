{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "solarmatch-installer-local-test",
  "main": "../dist/server/index.js",
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "../dist/client", "binding": "ASSETS" },
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "INSTALLER_PLATFORM_MODE": "local-test", "INSTALLER_BASE_URL": "http://localhost:3000", "OUTBOUND_MESSAGES_ENABLED": "false" },
  "d1_databases": [{ "binding": "DB", "database_name": "solarmatch-installer-local-test", "database_id": "00000000-0000-0000-0000-000000000006", "migrations_dir": "../migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "solarmatch-installer-local-test-private" }]
}
