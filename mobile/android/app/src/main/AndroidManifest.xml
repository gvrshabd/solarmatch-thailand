<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- allowBackup="false" stops backups only up to Android 11. From Android 12 the extraction
         rules also keep the signed-in session and WebView data out of cloud backup and
         phone-to-phone transfer. -->
    <application android:label="@string/app_name" android:icon="@mipmap/installer"
        android:allowBackup="false" android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules" tools:targetApi="33"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/InstallerTheme">
        <activity android:name=".InstallerActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
